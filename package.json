{
  "name": "rb-setup",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Install Ruby Butler in GitHub Actions",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/main.js --bundle --platform=node --target=node24 --format=cjs --minify --legal-comments=external --outfile=dist/index.cjs && esbuild tests/cache-action/main.js --bundle --platform=node --target=node24 --format=cjs --minify --legal-comments=external --outfile=dist/cache-probe.cjs",
    "lint": "oxlint --deny-warnings src tests",
    "test": "node --test"
  },
  "dependencies": {
    "@actions/cache": "6.2.0",
    "@actions/core": "3.0.1",
    "@actions/tool-cache": "4.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "oxlint": "1.93.0",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RubyElders/rb-setup.git"
  }
}
